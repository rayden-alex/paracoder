<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!--    <include resource="org/springframework/boot/logging/logback/defaults.xml" />-->
    <property name="LOG_HOME" value="log"/>
    <!--    <property name="CONSOLE_LOG_CHARSET" value="UTF-8"/>-->


    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n%rootException{3}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/paracoder.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_HOME}/paracoder.%d{yyyy-MM-dd}.log</fileNamePattern>

            <!-- keep 3 days' worth of history capped at 5MB total size -->
            <maxHistory>3</maxHistory>
            <totalSizeCap>5MB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook"/>


    <logger name="by.rayden.paracoder" level="DEBUG"/>
<!--    <logger name="java.lang.ProcessBuilder" level="TRACE" />-->

    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>

<!--    TRACE, DEBUG, INFO, WARN, ERROR, ALL or OFF-->
    <root level="ERROR">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
